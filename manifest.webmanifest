{
  "name": "بلكون — عقارات للبيع والإيجار",
  "short_name": "بلكون",
  "description": "عقارات للبيع والإيجار",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "dir": "rtl",
  "lang": "ar",
  "background_color": "#14213D",
  "theme_color": "#14213D",
  "categories": ["business", "shopping", "lifestyle"],
  "icons": [
    { "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/post",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "photos", "accept": ["image/*"] }] }
  },
  "shortcuts": [
    { "name": "للبيع", "url": "/search?deal=sale&source=pwa", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }] },
    { "name": "للإيجار", "url": "/search?deal=rent&source=pwa", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }] },
    { "name": "أضف إعلانك", "url": "/post?source=pwa", "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }] }
  ]
}
